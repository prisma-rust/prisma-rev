# Hidden folders (.*) — but keep CI config and agent skills tracked
.*/
!.github/
!.githooks/
!.claude/skills/
!.agents/skills/
/.worktrees/

# Rust build artifacts
/target
debug
target
build/

# Lockfile is fine to keep for a binary/app; uncomment to ignore if desired
# Cargo.lock

# Android Gradle build outputs
android/.gradle/
android/build/
android/app/build/
android/app/src/main/jniLibs/

# Screenshot / debug capture artifacts.
# NOTE: this is a blanket rule, so app icons must be re-included explicitly —
# they are build inputs (tauri.conf.json `bundle.icon`, Android res/mipmap-*),
# and a missing icons/32x32.png fails `tauri android build` at codegen.
*.png
!launcher/src-tauri/icons/*.png
!launcher/src-tauri/gen/android/app/src/main/res/**/*.png
!crates/prism-render/tests/goldens/*.png
# User-project art assets are build inputs too (fishing slice sprites).
# Fishing art is generated locally by scripts/gen_placeholder_sprites.py, which
# reads its file list from assets/data/lake_layers.json; run it with `--check` to
# verify a working copy still has every layer/time-of-day PNG.
projects/fishing/assets/sprites/
!projects/echowell/assets/sprites/*.png
# EchoWell's scene pack is generated by projects/echowell/scripts/run.ps1.
projects/echowell/assets/scenes.pak
projects/echowell/assets/scenes.pak.meta.json

# Python 自检脚本缓存
__pycache__/
*.pyc

# 场景保存的原子写临时文件与备份（见 editor core project.rs）
*.json.tmp
*.json.bak

# Node / Vite frontends (launcher + editor)
node_modules/
**/src-tauri/gen/schemas/

# Runtime logs
*.log
app_err.log
app_out.log

# Debug frame captures
frame_*.ppm

# Prebuilt slang toolchain (downloaded by CI via curl; glibc binary, not used
# on Termux). Never commit the 60+ MB release tree — it is fetched at build time.
tools/slang/

# Compiled SPIR-V (generated by assets/shaders/compile.sh on desktop/CI hosts).
# Never commit — .spv drift is the top CI failure source; build generates them.
# Android/Termux fetches prebuilt .spv from the CI `spirv` artifact instead.
assets/shaders/*.spv
assets/shaders/**/*.spv

# Precomputed IBL convolution cache (auto-generated; see docs/lessons-learned.md §32)
# `**/` prefix so it matches at any depth (e.g. crates/prism-render/assets/ibr/)
**/assets/ibr/

# Scene model assets (large; referenced via the assets/scenes.json manifest,
# not committed). The manifest file itself stays tracked.
# Engine-builtin cooked scenes + their sources (.rscn / .scene.json) are small
# and committed so the default scene loads without external assets.
assets/scenes/*
!assets/scenes/*.toml
!assets/scenes/*.rscn
!assets/scenes/*.scene.json

# Generated scene staging + packages (`prism-build-pipeline build-scenes`).
/assets/cooked/
/assets/*.pak
/assets/*.pak.meta.json

# Generated copies staged into the Android APK game payload by build-android.ps1.
# Static inputs such as the environment HDR stay tracked.
launcher/src-tauri/gen/android/app/src/main/assets/game/*.pak
launcher/src-tauri/gen/android/app/src/main/assets/game/*.pak.meta.json
launcher/src-tauri/gen/android/app/src/main/assets/game/settings.toml

assets/external
!assets/external/readme.md
# Deepwork session state
.slim/deepwork/
assets/heightmaps/

# Local secrets: GitHub App private keys, bot tokens, local env files.
*.pem
.secrets/
.env
.env.local

# Local reference material (extracted game assets, never committed)
.local/
